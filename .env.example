# ==========================================================================
# CRMIAA — Environment variable template
# Copy this file to `.env` and fill in real values:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
# ==========================================================================

# Secret key used to sign session cookies. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ---- SQL Server connection -----------------------------------------------
# Default instance:  .   or   localhost
# Named instance:    .\SQLEXPRESS   or   HOSTNAME\INSTANCE
DB_SERVER=.\SQLEXPRESS
DB_NAME=CRMIAA
# Use the driver actually installed on the machine. Check with:
#     python -c "import pyodbc; print(pyodbc.drivers())"
# Common values: "ODBC Driver 18 for SQL Server", "ODBC Driver 17 for SQL Server"
DB_DRIVER=ODBC Driver 18 for SQL Server

# Windows Authentication (default). For a SQL Server login instead, set
# DB_TRUSTED_CONNECTION=no and fill DB_USERNAME / DB_PASSWORD.
DB_TRUSTED_CONNECTION=yes
# DB_USERNAME=sa
# DB_PASSWORD=change-me

DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=5

# Set to true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false

# ---- CRIA / Gemini --------------------------------------------------------
# Used by app/cria/ai_client.py. Put the real key only in .env.
GEMINI_API_KEY=
